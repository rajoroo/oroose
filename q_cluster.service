Unit]
Description=DjangoQ Daemon
After=network.target

[Service]
User=ramesh
Group=ramesh
WorkingDirectory=/home/ramesh/oroose
ExecStart=/home/ramesh/oroose/venv/bin/python manage.py qcluster
ExecStop=/usr/bin/kill -s TERM $MAINPID
ExecReload=/usr/bin/kill -s HUP $MAINPID
Always=start

[Install]
WantedBy=multi-user.target
